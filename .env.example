# ---- data ----
PATHSNAP_DATA_DIR=./data
# folder of trips the API serves (student_test while developing; evaluator folder on demo day)
PATHSNAP_EVAL_DIR=./data/student_test
# ---- reproducibility / hardware ----
SEED=42
N_JOBS=-1
N_FOLDS=5
# ---- candidates ----
CANDIDATE_RADIUS_M=50
MAX_CANDIDATES=12
TRAIN_OBS_STEP=2
# ---- slow models train on a random subsample (0 = all rows) ----
MAX_TRAIN_ROWS_KNN=200000
MAX_TRAIN_ROWS_MLP=400000
MAX_TRAIN_ROWS_RF=0
MAX_TRAIN_ROWS_LGBM=0
MAX_TRAIN_ROWS_LOGREG=0
# ---- Bayesian optimisation ----
OPTUNA_TRIALS=30
# ---- UI (Laptop 2): IP of Laptop 1 ----
PATHSNAP_API_URL=http://127.0.0.1:8000
